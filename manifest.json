{
  "manifest_version": 3,
  "name": "墨水日記 · Ink Diary",
  "version": "0.4.0",
  "description": "把 AI 聊天介面化為一本神秘的墨水日記：你落筆，墨水滲入紙頁，日記再以墨水浮現回應你。",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage"],
  "action": {
    "default_title": "墨水日記 · Ink Diary",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*",
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://gemini.google.com/*"
      ],
      "css": ["diary.css"],
      "js": ["platforms/registry.js", "platforms/claude.js", "platforms/chatgpt.js", "platforms/gemini.js", "i18n/messages.js", "i18n/i18n.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["fonts/*"],
      "matches": [
        "https://claude.ai/*",
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://gemini.google.com/*"
      ]
    }
  ]
}
